# Evitar listados
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
</IfModule>

# Permitir acceso a endpoints públicos de API
<FilesMatch "^(qr|qr_test)\.php$">
  Require all granted
</FilesMatch>

# Asegurar que no se bloquee JSON POST básico
<IfModule mod_headers.c>
  Header always set Access-Control-Allow-Origin "*"
  Header always set Access-Control-Allow-Methods "POST, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, User-Agent, X-API-Key"
</IfModule>
